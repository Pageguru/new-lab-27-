rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-tenant laboratory operating system rules
    // Real-time live cross-device synchronization for all computers/laptops/mobiles
    match /vendor_labs/{labId} {
      allow read, write: if true;
    }
    match /lab_settings/{settingId} {
      allow read, write: if true;
    }
    match /reception_entries/{entryId} {
      allow read, write: if true;
    }
    match /lab_reports/{reportId} {
      allow read, write: if true;
    }
    match /vendor_bookings/{bookingId} {
      allow read, write: if true;
    }
    match /lab_staff/{staffId} {
      allow read, write: if true;
    }
    match /lab_tests/{testId} {
      allow read, write: if true;
    }
    match /lab_packages/{packageId} {
      allow read, write: if true;
    }
    match /lab_doctors/{doctorId} {
      allow read, write: if true;
    }
    match /vendor_branches/{branchId} {
      allow read, write: if true;
    }
    match /company_settings/{settingId} {
      allow read, write: if true;
    }
    match /portal_sections/{sectionId} {
      allow read, write: if true;
    }
    match /pricing_plans/{planId} {
      allow read, write: if true;
    }
    match /contact_submissions/{submissionId} {
      allow read, write: if true;
    }
    match /domain_requests/{requestId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

